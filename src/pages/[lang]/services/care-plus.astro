---
import LandingLayout from '../../../layouts/LandingLayout.astro';
import LandingHeader from '../../../components/sections/LandingHeader.astro'; 
import Footer from '../../../components/sections/Footer.astro'; 
import Button from '../../../components/ui/Button.astro';
import FounderSignature from '../../../components/sections/FounderSignature.astro';
import CaseStudySection from '../../../components/sections/CaseStudySection.astro';
import RiskReversal from '../../../components/sections/RiskReversal.astro';
import IncludedTable from '../../../components/sections/IncludedTable.astro';
import FAQBlock from '../../../components/sections/FAQBlock.astro';
import SoftCTA from '../../../components/sections/SoftCTA.astro';

import { getI18n } from '../../../i18n/utils';
import { generateHreflangLinks } from '../../../i18n/hreflang';
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE } from '../../../i18n/config';
import type { Language } from '../../../i18n/config';
import { getOrganizationSchema, getServiceSchema, getBreadcrumbSchema, getFAQPageSchema } from '../../../utils/schema';
import ServiceAnalytics from '../../../components/seo/ServiceAnalytics.astro';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES
    .filter((lang) => lang !== DEFAULT_LANGUAGE)
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const data = getI18n(lang) as any;
const { footer, nav, carePlusPage } = data;
const hreflangLinks = generateHreflangLinks('/services/care-plus', 'https://base-pages.com');
const canonicalUrl = `https://base-pages.com/${lang}/services/care-plus`;
const jsonLd = [
  getOrganizationSchema(),
  getBreadcrumbSchema([
    { name: carePlusPage.breadcrumb?.home ?? 'Home', url: `/${lang}/` },
    { name: carePlusPage.breadcrumb?.services ?? 'Services', url: `/${lang}/services` },
    { name: carePlusPage.breadcrumb?.current ?? carePlusPage.hero.titleBold, url: `/${lang}/services/care-plus` },
  ]),
  getServiceSchema({
    name: carePlusPage.hero.titleBold,
    description: carePlusPage.hero.titleLight,
    price: '490',
    url: `/${lang}/services/care-plus`,
  }),
  ...(carePlusPage.faq?.items?.length ? [getFAQPageSchema(carePlusPage.faq.items)] : []),
];
---

<LandingLayout
  title={carePlusPage.meta.ogTitle}
  description={carePlusPage.meta.ogDescription}
  canonicalUrl={canonicalUrl}
  lang={lang}
  hreflangLinks={hreflangLinks}
  jsonLd={jsonLd}
  ogImage="https://base-pages.com/images/og/og-care.png"
>
  
  <ServiceAnalytics tier="care-plus" />
  <LandingHeader navData={nav} />

  <main id="tier-care-plus" class="care-page">
    <section class="hero-section">
      <div class="container hero-inner">
        <div class="tagline">
          <div class="line"></div> {carePlusPage.hero.tagline}
        </div>
        <h1 class="main-title">
          <span class="title-bold">{carePlusPage.hero.titleBold}</span>
          <span class="title-light">{carePlusPage.hero.titleLight}</span>
        </h1>
        <p class="hero-subtitle">
          {carePlusPage.hero.subtitle}
        </p>
        <div class="hero-badges">
          <span class="pill">{carePlusPage.hero.priceBadge}</span>
          <span class="pill border-pill">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 16px; height: 16px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            {carePlusPage.hero.deliveryBadge}
          </span>
        </div>
      </div>
    </section>

    <section id="services-section" class="scroll-container">
      
      <div class="left-col">
        <div class="animation-wrapper">
          <svg id="care-plus-shape" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="careplus-glow" x1="0%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="rgba(255,255,255,0)" />
                <stop offset="50%" stop-color="rgba(255,255,255,0.85)" />
                <stop offset="100%" stop-color="rgba(255,255,255,0)" />
              </linearGradient>
              <clipPath id="careplus-clip">
                <rect x="78" y="230" width="64" height="90" rx="22" />
                <rect x="168" y="170" width="64" height="150" rx="22" />
                <rect x="258" y="110" width="64" height="210" rx="22" />
              </clipPath>
              <filter id="careplus-wave" x="-20%" y="-20%" width="140%" height="140%">
                <feTurbulence type="fractalNoise" baseFrequency="0.004" numOctaves="1" result="noise" />
                <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" id="careplus-disp" />
              </filter>
            </defs>

            <g id="care-plus-group" filter="url(#careplus-wave)">
              <rect class="signal-bar" x="78" y="230" width="64" height="90" rx="22" fill="url(#brand-gradient)" />
              <rect class="signal-bar" x="168" y="170" width="64" height="150" rx="22" fill="url(#brand-gradient)" />
              <rect class="signal-bar" x="258" y="110" width="64" height="210" rx="22" fill="url(#brand-gradient)" />
              <rect id="careplus-glow-rect" x="40" y="340" width="320" height="90" fill="url(#careplus-glow)" clip-path="url(#careplus-clip)" opacity="0" />
            </g>
          </svg>
        </div>
        <Button href={carePlusPage.finalCta.buttonUrl} class="bg-black text-white w-full justify-center py-3.5 !rounded-2xl text-[15px] font-medium hover:scale-105 transition-transform">
          {carePlusPage.finalCta.buttonText}
        </Button>
      </div>

      <div class="right-col">
        <h2 class="sr-only">{carePlusPage.featuresSectionHeading}</h2>
        {carePlusPage.features.map((feature: any, index: number) => (
          <div class="feature-card">
            <div class="icon-wrapper">
              {index === 0 && <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>}
              {index === 1 && <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>}
              {index === 2 && <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>}
              {index === 3 && <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>}
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
        ))}
      </div>
    </section>

    {carePlusPage.howItWorks && (
      <section class="how-section">
        <div class="container">
          <p class="how-tagline">{carePlusPage.howItWorks.sectionTagline}</p>
          <h2 class="how-headline">{carePlusPage.howItWorks.sectionHeadline}</h2>
          <div class="how-grid">
            {carePlusPage.howItWorks.steps.map((step: any, index: number) => (
              <div class="how-step">
                <span class="how-num">{String(index + 1).padStart(2, '0')}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <IncludedTable
      sectionTagline={carePlusPage.included.sectionTagline}
      sectionHeadline={carePlusPage.included.sectionHeadline}
      columnLabels={carePlusPage.included.columnLabels}
      included={carePlusPage.included.included}
      excluded={carePlusPage.included.excluded}
      optional={carePlusPage.included.optional}
    />

    <CaseStudySection data={carePlusPage.caseStudy} />

    <RiskReversal
      title={carePlusPage.riskReversal.title}
      points={carePlusPage.riskReversal.points}
    />

    {carePlusPage.faq?.items?.length > 0 && (
      <FAQBlock
        title={carePlusPage.faq.sectionHeadline}
        items={carePlusPage.faq.items}
      />
    )}

    {carePlusPage.softCta && (
      <SoftCTA
        eyebrow={carePlusPage.softCta.eyebrow}
        headline={carePlusPage.softCta.headline}
        subtitle={carePlusPage.softCta.subtitle}
        emailLabel={carePlusPage.softCta.emailLabel}
        emailPlaceholder={carePlusPage.softCta.emailPlaceholder}
        buttonText={carePlusPage.softCta.buttonText}
        successMessage={carePlusPage.softCta.successMessage}
        privacyNote={carePlusPage.softCta.privacyNote}
        tier="care-plus"
        pdfHref={`/one-pagers/${lang}/care-plus-one-pager.pdf`}
      />
    )}

    <section class="final-cta-section">
      <div class="container">
        <FounderSignature
          name={carePlusPage.founder.name}
          role={carePlusPage.founder.role}
          message={carePlusPage.founder.message}
          class="mb-6"
        />
        <div class="cta-box">
          <h2>{carePlusPage.finalCta.headline}</h2>
          <p>{carePlusPage.finalCta.subtitle}</p>
          <div class="flex justify-center mt-6">
            <Button 
              href={carePlusPage.finalCta.buttonUrl} 
              class="bg-white text-gray-900 px-8 py-3.5 !rounded-2xl font-medium hover:scale-105 transition-transform shadow-sm"
            >
              {carePlusPage.finalCta.buttonText}
            </Button>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer data={footer} />

</LandingLayout>

<style>
  :root {
    --text-main: #111827;
    --text-muted: #9ca3af;
  }

  .care-page { padding-top: 100px; }
  .container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  svg { width: 18px; height: 18px; }

  .main-title { margin: 0 0 32px 0; display: flex; flex-direction: column; gap: 4px; }
  .title-bold { font-size: clamp(36px, 5vw, 64px); font-weight: 600; letter-spacing: -1px; line-height: 1.05; color: var(--text-main); }
  .title-light { font-size: clamp(22px, 3vw, 36px); font-weight: 400; letter-spacing: -1px; line-height: 1.2; color: var(--text-main); }
  .hero-subtitle { font-size: 18px; line-height: 1.6; font-weight: 400; color: var(--text-main); max-width: 600px; margin: 0 0 40px 0; }

  .hero-section { padding: 80px 0 40px 0; }
  .hero-inner { max-width: 800px; margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .tagline { display: flex; align-items: center; gap: 15px; font-family: 'Roboto Mono', monospace; font-size: 13px; letter-spacing: 2px; color: var(--text-muted); margin-bottom: 30px; font-weight: 700; }
  .line { height: 2px; width: 30px; background: var(--text-main); }
  .hero-badges { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .pill { background: #ebebeb; color: var(--text-main); padding: 10px 20px; border-radius: 999px; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .border-pill { background: transparent; border: 1px solid #d1d5db; color: #6b7280; }

  .scroll-container { display: flex; flex-direction: column; gap: 40px; padding: 20px 24px 80px 24px; align-items: flex-start; }

  .left-col { flex: 1; display: flex; flex-direction: column; position: sticky; top: 80px; z-index: 10; background: transparent; padding: 0 24px 20px 24px; margin: 0 -24px; width: calc(100% + 48px); }

  .animation-wrapper { width: 100%; max-width: 260px; margin: 0 auto; aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; background: transparent; border-radius: 20px; overflow: hidden; }

  #care-plus-shape { width: 100%; height: 100%; transform-origin: center; will-change: transform, filter, opacity; }

  .right-col { flex: 1; display: flex; flex-direction: column; gap: 24px; z-index: 1; width: 100%; }
  
  .feature-card { background: white; padding: 32px 24px; border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.02); border: 1px solid rgba(229, 231, 235, 0.4); }
  .icon-wrapper { width: 48px; height: 48px; background: #f8f7f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 24px; color: var(--text-main); }
  .feature-card h3 { font-size: 22px; margin: 0 0 12px 0; font-weight: 600; color: var(--text-main); }
  .feature-card p { font-size: 15px; line-height: 1.7; font-weight: 400; color: var(--text-main); margin: 0; }

  /* How it works — calm, numbered */
  .how-section { padding: 20px 0 80px 0; }
  .how-tagline { font-family: 'Roboto Mono', monospace; font-size: 13px; letter-spacing: 2px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; margin: 0 0 16px 0; }
  .how-headline { font-size: clamp(28px, 4vw, 40px); font-weight: 500; letter-spacing: -1px; color: var(--text-main); margin: 0 0 40px 0; max-width: 16ch; }
  .how-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
  .how-step { background: white; padding: 32px 24px; border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.02); border: 1px solid rgba(229, 231, 235, 0.4); }
  .how-num { font-family: 'Roboto Mono', monospace; font-size: 13px; font-weight: 700; color: var(--text-muted); letter-spacing: 1px; }
  .how-step h3 { font-size: 20px; margin: 12px 0 8px 0; font-weight: 600; color: var(--text-main); }
  .how-step p { font-size: 15px; line-height: 1.7; color: var(--text-main); margin: 0; }

  .final-cta-section { padding: 0 0 80px 0; }
  .cta-box { background: var(--text-main); border-radius: 20px; padding: 60px 24px; text-align: center; color: white; }
  .cta-box h2 { font-size: clamp(28px, 4vw, 40px); font-weight: 500; letter-spacing: -1px; margin: 0 0 16px 0; }
  .cta-box p { color: #9ca3af; font-size: 18px; margin: 0 0 24px 0; }

  @media (max-width: 899px) {
    .animation-wrapper { display: none !important; }
  }

  @media (min-width: 900px) {
    .container { padding: 0 40px; }
    .hero-section { padding: 120px 0 80px 0; }
    .main-title { gap: 8px; }
    .title-bold { letter-spacing: -2px; }
    .scroll-container { flex-direction: row; gap: 80px; padding: 40px 40px 120px 40px; }
    .left-col { top: 100px; z-index: auto; margin: 0; width: auto; background: white; padding: 40px; border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.02); border: 1px solid rgba(229, 231, 235, 0.4); }
    .animation-wrapper { max-width: none; }
    .right-col { gap: 40px; width: auto; }
    .feature-card { padding: 40px; }
    .how-section { padding: 20px 0 120px 0; }
    .how-grid { grid-template-columns: repeat(2, 1fr); gap: 32px; }
    .how-step { padding: 40px; }
    .final-cta-section { padding: 0 0 120px 0; }
    .cta-box { padding: 80px 40px; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  function initCarePlusAnimations() {
    gsap.registerPlugin(ScrollTrigger);
    ScrollTrigger.getAll().forEach(t => t.kill());

    let mm = gsap.matchMedia();

    // DESKTOP: rising signal — bars sharpen into focus, a soft light sweeps upward.
    mm.add("(min-width: 900px)", () => {
      const shapeSvg = document.getElementById('care-plus-shape');
      const glow = document.getElementById('careplus-glow-rect');
      const waveDisp = document.getElementById('careplus-disp');

      if (!shapeSvg) return;

      gsap.set(shapeSvg, { opacity: 0, filter: "blur(12px)", y: 0, scale: 1 });
      gsap.set(glow, { attr: { y: 340 }, opacity: 0 });
      gsap.set(waveDisp, { attr: { scale: 0 } });

      const tlDesktop = gsap.timeline({
        scrollTrigger: {
          trigger: "#services-section",
          start: "top 65%",
          end: "bottom bottom",
          scrub: 1,
        }
      });

      tlDesktop.to(shapeSvg, { opacity: 1, filter: "blur(0px)", duration: 25, ease: "power2.out" }, 0)
        .to(waveDisp, { attr: { scale: 8 }, duration: 25, ease: "sine.inOut" }, 25)
        .to(glow, { opacity: 1, duration: 5, ease: "power1.inOut" }, 50)
        .to(glow, { attr: { y: -90 }, duration: 25, ease: "none" }, 50)
        .to(glow, { opacity: 0, duration: 5, ease: "power1.inOut" }, 70)
        .to(waveDisp, { attr: { scale: 2 }, duration: 25, ease: "sine.inOut" }, 75)
        .to(shapeSvg, { y: 15, scale: 0.98, duration: 25, ease: "power2.inOut" }, 75);
    });

    // MOBILE: gentle logo breathing (mirrors the Care page behaviour).
    mm.add("(max-width: 899px)", () => {
      const isotipo = document.querySelector('.isotipo');
      const logoContainer = document.querySelector('.logo-container');
      const wordBase = document.querySelector('.word-base');
      const wordPages = document.querySelector('.word-pages');
      const connector = document.querySelector('.connector');
      const textContainer = document.querySelector('.text-container');
      const dispMapGlobal = document.getElementById('disp-map');

      if (!isotipo) return;

      gsap.set(logoContainer, { gap: "16px" });
      gsap.set(isotipo, { rotation: -90, width: "26px", height: "48px", borderRadius: "3px" });
      gsap.set(textContainer, { marginTop: "-3px" });
      gsap.set(wordBase, { x: 0, y: 0 });
      gsap.set(wordPages, { x: 0, y: 0 });
      gsap.set(connector, { width: "14px", opacity: 1, x: 0 });

      const tlMobile = gsap.timeline({
        scrollTrigger: {
          trigger: "#services-section",
          start: "top 70%",
          end: "bottom 80%",
          scrub: 1,
        }
      });

      tlMobile.to(logoContainer, { gap: "7px", duration: 25, ease: "power2.inOut" }, 0)
        .to(isotipo, { rotation: 0, width: "32px", height: "32px", borderRadius: "10px", duration: 25, ease: "power2.inOut" }, 0)
        .to(textContainer, { marginTop: "-5px", duration: 25, ease: "power2.inOut" }, 0)
        .to(wordBase, { x: 0, y: -9, duration: 25, ease: "power2.inOut" }, 0)
        .to(wordPages, { x: -58, y: 9, duration: 25, ease: "power2.inOut" }, 0)
        .to(connector, { width: 0, opacity: 0, x: -10, duration: 25, ease: "power2.inOut" }, 0)
        .to(dispMapGlobal, { attr: { scale: 12 }, duration: 12.5, ease: "sine.inOut" }, 25)
        .to(dispMapGlobal, { attr: { scale: 2 }, duration: 12.5, ease: "sine.inOut" }, 37.5)
        .to(isotipo, { boxShadow: "0 0 0 4px #f8f7f5, 0 0 0 5.5px rgba(168, 191, 175, 0.5)", duration: 25, ease: "power1.inOut" }, 40)
        .to(wordBase, { x: 6, duration: 20, ease: "power1.inOut" }, 40)
        .to(wordPages, { x: -52, duration: 20, ease: "power1.inOut" }, 45)
        .to(isotipo, { scale: 1.05, duration: 25, ease: "none" }, 75);
    });
  }

  document.addEventListener('DOMContentLoaded', initCarePlusAnimations);
  document.addEventListener('astro:page-load', initCarePlusAnimations);
</script>
