---
/** "What it's like to work with me" — three short points on the homepage. */
interface Props {
  data: {
    tagline: string;
    items: { title: string; description: string }[];
  };
}

const { data } = Astro.props;
---

<section class="max-w-7xl mx-auto px-6 py-20 md:py-28">
  <div class="flex items-center gap-4 mb-12 md:mb-16">
    <div class="h-[2px] w-12 bg-[linear-gradient(90deg,#A8BFAF_0%,#E8DDC8_50%,#F6D7C8_100%)]"></div>
    <span class="text-sm font-bold tracking-widest uppercase text-gray-900">{data.tagline}</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
    {data.items.map((item) => (
      <div class="flex flex-col gap-3">
        <h3 class="text-[18px] md:text-[20px] font-semibold text-gray-900 leading-tight">
          {item.title}
        </h3>
        <p class="text-gray-500 leading-relaxed">{item.description}</p>
      </div>
    ))}
  </div>
</section>
