---
// src/components/sections/Hero.astro
import { Image } from 'astro:assets';
import franPhoto from '../../assets/team/fran-hero.jpg';

interface Props {
  data: any;
}

const { data } = Astro.props;

/** The main CTA points at WhatsApp, so it opens in a new tab and shows the icon. */
const isExternalCta = typeof data.ctaUrl === 'string' && data.ctaUrl.startsWith('http');

/**
 * Both headline lines stay on screen. The words still rise into place on load —
 * the same effect as before, but it plays once instead of looping, so the
 * visitor's half of the idea ("You speak your practice.") never disappears.
 */
const lines: string[] = data.titles ?? [];
let wordIndex = 0;
const headline = lines.map((line: string) => ({
  line,
  words: line.split(' ').map((word) => ({ word, delay: (wordIndex++ * 0.06).toFixed(2) })),
}));
---

<section class="hero-section relative w-full mt-[var(--header-height)] pt-10 md:pt-16 pb-16 md:pb-24">
  <div class="max-w-6xl mx-auto px-6 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:items-center">

    {/* ── Headline ─────────────────────────────────────── */}
    <div class="order-1 lg:col-start-1 lg:row-start-1 lg:self-end">
      {data.eyebrow && (
        <p class="hero-fade text-[12px] md:text-[13px] font-bold tracking-[0.18em] uppercase text-[var(--color-text-muted)] mb-5 md:mb-7">
          {data.eyebrow}
        </p>
      )}

      <h1 class="text-[34px] md:text-[46px] lg:text-[52px] font-semibold tracking-tighter leading-[1.08] text-balance">
        {headline.map(({ line, words }, lineIndex) => (
          <span class="block overflow-hidden py-[0.06em]">
            <span class:list={['block', lineIndex === 0 ? 'text-gray-900' : 'text-gray-400']}>
              {words.map(({ word, delay }) => (
                <span class="hero-word inline-block mr-[0.22em]" style={`animation-delay: ${delay}s`}>
                  {word}
                </span>
              ))}
            </span>
            <span class="sr-only">{line}</span>
          </span>
        ))}
      </h1>
    </div>

    {/* ── Photo ────────────────────────────────────────── */}
    <div class="order-2 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center flex justify-center lg:justify-end">
      <div class="hero-fade hero-photo relative">
        <div
          class="absolute -inset-3 md:-inset-4 rounded-[36px] bg-[linear-gradient(135deg,#A8BFAF_0%,#E8DDC8_50%,#F6D7C8_100%)] opacity-70"
          aria-hidden="true"
        ></div>

        <Image
          src={franPhoto}
          alt={data.photoAlt ?? ''}
          width={320}
          height={320}
          densities={[1, 2]}
          loading="eager"
          class="relative w-[220px] h-[220px] md:w-[280px] md:h-[280px] lg:w-[320px] lg:h-[320px] object-cover rounded-[28px] shadow-[0_20px_50px_rgba(0,0,0,0.12)]"
        />

        {data.photoChip && (
          <span class="absolute bottom-3 left-3 md:bottom-4 md:left-4 bg-white/90 backdrop-blur-sm text-gray-900 text-[13px] font-medium px-3 py-1.5 rounded-full shadow-sm">
            {data.photoChip}
          </span>
        )}
      </div>
    </div>

    {/* ── Subtitle, buttons, language note ─────────────── */}
    <div class="order-3 lg:col-start-1 lg:row-start-2 lg:self-start">
      <p class="hero-fade text-[16px] md:text-[18px] text-[var(--color-text-muted)] leading-relaxed max-w-xl">
        {data.subtitle}
      </p>

      <div class="hero-fade flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 mt-8">
        <a
          href={data.ctaUrl || '#services'}
          {...isExternalCta ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
          class="inline-flex items-center justify-center gap-2.5 bg-black text-white px-8 py-4 rounded-2xl font-medium hover:scale-105 transition-transform shadow-lg"
        >
          {isExternalCta && (
            <svg class="h-5 w-5 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29Z" />
            </svg>
          )}
          {data.cta}
        </a>

        {data.secondaryCta && (
          <a
            href={data.secondaryCtaUrl || '#services'}
            class="inline-flex items-center gap-1.5 text-gray-900 font-medium hover:text-gray-500 transition-colors"
          >
            {data.secondaryCta} →
          </a>
        )}
      </div>

      {data.languageNote && (
        <p class="hero-fade text-[14px] text-[var(--color-text-muted)] mt-6">{data.languageNote}</p>
      )}
    </div>
  </div>
</section>

<style>
  /* Words rise into place once, then stay put. */
  .hero-word {
    display: inline-block;
    transform: translateY(110%);
    opacity: 0;
    animation: hero-word-in 0.75s cubic-bezier(0.34, 1.4, 0.64, 1) forwards;
  }

  @keyframes hero-word-in {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .hero-fade {
    opacity: 0;
    transform: translateY(12px);
    animation: hero-fade-in 0.7s ease-out 0.35s forwards;
  }

  @keyframes hero-fade-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-photo {
    animation-delay: 0.2s;
  }

  /* Anyone who asks for less motion gets the finished state immediately. */
  @media (prefers-reduced-motion: reduce) {
    .hero-word,
    .hero-fade {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
